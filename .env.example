# Copy to .env and fill in as needed. Never commit real secrets.
# All settings are optional; the system runs end-to-end with no keys.

ACP_APP_ENV=dev
ACP_DATABASE_URL=sqlite+aiosqlite:///./acp.db
ACP_ARTIFACT_DIR=.acp/artifacts
ACP_WORKSPACE_DIR=.acp/workspaces

ACP_DEFAULT_TOKEN_BUDGET=80000
ACP_DEFAULT_COST_BUDGET_USD=5.0
ACP_DEFAULT_COMMAND_TIMEOUT_S=120

ACP_ALLOW_NETWORK_BY_DEFAULT=false
ACP_ENABLE_EXTERNAL_AGENTS=false

# Optional API keys for live agent adapters (never required for tests).
# ACP_OPENAI_API_KEY=sk-...
# ACP_ANTHROPIC_API_KEY=sk-ant-...
